  "item": [
    {
      "name": "01 - Login do administrador",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Inicializa dados unicos para cada execucao da collection.",
              "const runId = Date.now().toString().slice(-8);",
              "",
              "function gerarCpfValido(base9) {",
              "  const nums = base9.split('').map(Number);",
              "  let soma = nums.reduce((acc, n, i) => acc + n * (10 - i), 0);",
              "  let d1 = 11 - (soma % 11); d1 = d1 >= 10 ? 0 : d1;",
              "  const nums10 = [...nums, d1];",
              "  soma = nums10.reduce((acc, n, i) => acc + n * (11 - i), 0);",
              "  let d2 = 11 - (soma % 11); d2 = d2 >= 10 ? 0 : d2;",
              "  return `${base9}${d1}${d2}`;",
              "}",
              "",
              "const base = String(Math.floor(100000000 + Math.random() * 899999999));",
              "pm.collectionVariables.set(\"runId\", runId);",
              "pm.collectionVariables.set(\"clienteDocumento\", gerarCpfValido(base));",
              "pm.collectionVariables.set(\"clienteNome\", `Cliente E2E ${runId}`);",
              "pm.collectionVariables.set(\"clienteEmail\", `cliente.e2e.${runId}@oficina360.test`);",
              "pm.collectionVariables.set(\"clienteSenha\", `Senha@${runId}`);",
              "pm.collectionVariables.set(\"clienteTelefone\", `119${runId}`.slice(0, 11));",
              "",
              "const letras = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
              "const placa = `${letras[Math.floor(Math.random()*26)]}${letras[Math.floor(Math.random()*26)]}${letras[Math.floor(Math.random()*26)]}${Math.floor(Math.random()*10)}${letras[Math.floor(Math.random()*26)]}${String(Math.floor(Math.random()*100)).padStart(2,'0')}`;",
              "pm.collectionVariables.set(\"veiculoPlaca\", placa);",
              "pm.collectionVariables.set(\"servicoCodigo\", `SRV-E2E-${runId}`);",
              "pm.collectionVariables.set(\"estoqueCodigo\", `EST-E2E-${runId}`);",
              "pm.collectionVariables.unset(\"adminToken\");",
              "pm.collectionVariables.unset(\"clienteToken\");",
              "pm.collectionVariables.unset(\"ordemServicoId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.expect(json.token, 'Token do administrador').to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('adminToken', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Autentica o administrador e inicializa os dados unicos da execucao."
      },
      "response": []
    },
