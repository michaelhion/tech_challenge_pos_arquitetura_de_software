      "name": "15 - Validar reserva no estoque",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "",
              "const quantidadeInicial = Number(",
              "    pm.collectionVariables.get(\"quantidadeEstoqueInicial\")",
              ");",
              "",
              "const quantidadeUtilizada = Number(",
              "    pm.collectionVariables.get(\"quantidadeUtilizada\")",
              ");",
              "",
              "const quantidadeFinal =",
              "    quantidadeInicial - quantidadeUtilizada;",
              "",
              "pm.test(\"Status HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Quantidade utilizada foi baixada do estoque\", function () {",
              "    pm.expect(json.quantidade).to.eql(quantidadeFinal);",
              "});",
              "",
              "pm.test(\"Não existem reservas pendentes\", function () {",
              "    pm.expect(json.reservados).to.eql(0);",
              "});",
              "",
              "pm.test(\"Quantidade disponível está correta\", function () {",
              "    pm.expect(json.disponiveis).to.eql(quantidadeFinal);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/estoque/listar/{{estoqueCodigo}}",
          "host": [
